# A regional game node: runs rooms near its players; the main server keeps
# the website, accounts, the map library and the room list.
# Copy to /etc/neobox.env on the node's own server (chmod 600) and install
# neobox exactly like the main server (same binary, same neobox.service).

# The main server's base URL. Setting it makes this server a game node.
NEOBOX_MAIN=https://neobox.example.org
# The same long random secret as NEOBOX_CLUSTER_SECRET on the main server.
NEOBOX_CLUSTER_SECRET=change-me-to-the-main-servers-secret
# How browsers reach this node (its own HTTPS name, served by its own Caddy).
NEOBOX_PUBLIC_URL=https://us.neobox.example.org

# Shown in the room list; new rooms and quick play go to the nearest server.
NEOBOX_REGION=New York
NEOBOX_LOCATION=40.71,-74.01

# WebRTC (UDP) game transport, as on the main server.
NEOBOX_RTC_BIND=0.0.0.0:3478
#NEOBOX_RTC_PUBLIC=203.0.113.20:3478

#NEOBOX_MAX_ROOMS=200
#NEOBOX_MAX_PLAYERS=32
#NEOBOX_MAX_CONNS_PER_IP=8
