# Copy to /etc/neobox.env (chmod 600). Lines are NAME=value.

# Password for https://<your domain>/admin (required to enable the admin page).
NEOBOX_ADMIN_PASSWORD=change-me-to-a-long-random-password

# WebRTC (UDP) game transport. The port must be open in the firewall.
NEOBOX_RTC_BIND=0.0.0.0:3478
# The server's public IPv4 address and the same port. Optional: detected
# automatically on most VPSes; set it if players fall back to "ws".
#NEOBOX_RTC_PUBLIC=203.0.113.10:3478

# Limits (defaults shown).
#NEOBOX_MAX_ROOMS=200
#NEOBOX_MAX_PLAYERS=32
#NEOBOX_MAX_CONNS_PER_IP=8

# Where this server is: the room list measures distances to it (needs the
# geolocation database, see neobox-geoip.timer).
#NEOBOX_LOCATION=50.11,8.68

# Regional game nodes (optional; see DEPLOY.md "Regional game servers").
# This server's region name in the room list, its public base URL, and the
# secret the nodes share with it. Leave the secret empty to run alone.
#NEOBOX_REGION=Frankfurt
#NEOBOX_PUBLIC_URL=https://neobox.example.org
#NEOBOX_CLUSTER_SECRET=
